    "morgan": "^1.9.1",
    "multer": "^1.4.5-lts.1",
    "react-beforeunload": "^2.4.0",
    "react-moment": "^1.1.3",
    "react-router-dom": "^6.22.3",
    "socket.io": "^4.7.5",
