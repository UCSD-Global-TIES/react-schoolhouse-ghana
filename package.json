    "@emotion/styled": "^11.11.5",
    "@material-ui/lab": "^4.0.0-alpha.57",
    "@mui/icons-material": "^5.15.15",
    "@mui/material": "^5.15.15",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.19.0",
    "check-disk-space": "^3.4.0",
    "cookie-parser": "^1.4.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "events": "^3.0.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "extract-zip": "^2.0.1",
